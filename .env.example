# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Swap models without touching code. Any of these can point at another model.
BIBLE_MODEL=claude-opus-5-5
TAGGING_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
VIEWER_MODEL=claude-opus-5-5

# Only for LLM_PROVIDER=openai_compatible (Gemini, Groq, OpenRouter, OpenAI, a provided API...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
